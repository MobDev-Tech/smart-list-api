# ==============================================================================
# SMART LIST API - ENVIRONMENT VARIABLES TEMPLATE
# Instructions: Copy this file to '.env' in the root directory and fill in the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL DATABASE CONFIGURATION
# Used by: Docker Compose (Postgres container) & Spring Boot (Local connection)
# ------------------------------------------------------------------------------
# Database name to be automatically created on setup
POSTGRES_DB=smart_list_db

# Primary database superuser username
POSTGRES_USER=postgres

# Superuser password (REQUIRED - set a secure password for local dev, e.g., postgrespassword)
POSTGRES_PASSWORD=

# Database host (Use 'postgres' when running inside Docker, or 'localhost' when running Spring Boot locally)
DB_HOST=localhost
DB_PORT=5432

# Complete JDBC URL used by Spring Boot when running outside Docker
# Optional: Spring will construct this automatically if DB_HOST and DB_PORT are set
DB_URL=jdbc:postgresql://localhost:5432/smart_list_db


# ------------------------------------------------------------------------------
# 2. PGADMIN 4 WEB INTERFACE CONFIGURATION
# Used by: Docker Compose (pgAdmin container)
# Accessible at: http://localhost:5050 after running 'docker compose up'
# ------------------------------------------------------------------------------
# Default login email for the pgAdmin dashboard
PGADMIN_EMAIL=admin@admin.com

# Default login password for pgAdmin dashboard
PGADMIN_PASSWORD=admin