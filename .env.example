# ==============================================================================
# SMART LIST API - MODELO DE VARIÁVEIS DE AMBIENTE
# Instruções: copie este arquivo para '.env' na raiz do projeto e preencha os valores.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURAÇÃO DO BANCO DE DADOS POSTGRESQL
# Usado por: Docker Compose (container do Postgres) e Spring Boot (conexão local)
# ------------------------------------------------------------------------------
# Nome do banco de dados criado automaticamente durante a inicialização
POSTGRES_DB=smart_list_db

# Nome do usuário administrador do banco de dados
POSTGRES_USER=postgres

# Senha do usuário administrador (OBRIGATÓRIA: defina uma senha segura para desenvolvimento local)
POSTGRES_PASSWORD=

# Endereço do banco (use 'postgres' dentro do Docker ou 'localhost' ao executar o Spring Boot localmente)
DB_HOST=localhost
DB_PORT=5432

# URL JDBC completa usada pelo Spring Boot fora do Docker
# Opcional: o Spring pode montá-la automaticamente se DB_HOST e DB_PORT estiverem definidos
DB_URL=jdbc:postgresql://localhost:5432/smart_list_db


# ------------------------------------------------------------------------------
# 2. CONFIGURAÇÃO DA INTERFACE WEB DO PGADMIN 4
# Usado por: Docker Compose (container do pgAdmin)
# Acesse em: http://localhost:5050 após executar 'docker compose up'
# ------------------------------------------------------------------------------
# E-mail padrão para acessar o painel do pgAdmin
PGADMIN_EMAIL=admin@admin.com

# Senha padrão para acessar o painel do pgAdmin
PGADMIN_PASSWORD=admin